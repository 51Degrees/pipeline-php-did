{
    "name": "51degrees/fiftyone.pipeline.did",
    "description": "Strongly typed reader for the 51Did (51Degrees Identifier) returned by the 51Degrees Cloud service, and a client for the cloud's 51Did endpoints (public keys, signature verification and creator context redemption). Parses the OWID envelope and exposes the usage, the identifier type, the License Id, the match key and the terms. Compare match keys, never envelopes.",
    "keywords": [
        "51degrees",
        "51did",
        "fodid",
        "owid"
    ],
    "authors": [
        {
            "name": "51Degrees Engineering",
            "email": "engineering@51degrees.com"
        }
    ],
    "license": "EUPL-1.2",
    "type": "library",
    "homepage": "https://51degrees.com/developers/51did?utm_source=packagist&utm_medium=package&utm_campaign=51degrees-php&utm_content=fiftyone.pipeline.did&utm_term=homepage",
    "support": {
        "source": "https://github.com/51Degrees/51degrees-php",
        "docs": "https://51degrees.com/documentation/_identifiers_51_did.html?utm_source=packagist&utm_medium=package&utm_campaign=51degrees-php&utm_content=fiftyone.pipeline.did&utm_term=documentation"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "*"
    },
    "autoload": {
        "psr-4": {
            "fiftyone\\pipeline\\did\\": "src/",
            "SwanCommunity\\Owid\\": "third-party/swan-community/owid/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "fiftyone\\pipeline\\did\\tests\\": "tests/"
        }
    }
}
